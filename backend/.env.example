# Environment Variables — Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret — use a random string of at least 64 characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_jwt_secret_min_64_chars_here

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
